#!/usr/bin/env bash
# YanMo IME Daemon launcher script

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
if [ -f "$DIR/.venv/bin/python" ]; then
    PYTHON="$DIR/.venv/bin/python"
elif [ -f "$DIR/tools/.venv/bin/python" ]; then
    PYTHON="$DIR/tools/.venv/bin/python"
else
    PYTHON="python3"
fi

export PYTHONPATH="$DIR:$PYTHONPATH"

ACTION="${1:-run}"

if [ "$ACTION" = "start" ]; then
    # Check if already running
    "$PYTHON" -m daemon.yanmo_daemon status | grep -q "正常运行中"
    if [ $? -eq 0 ]; then
        "$PYTHON" -m daemon.yanmo_daemon status
        exit 0
    fi
    LOG_FILE="$HOME/.local/share/yanmo/daemon.log"
    setsid "$PYTHON" -u -m daemon.yanmo_daemon run > "$LOG_FILE" 2>&1 &
    DAEMON_PID=$!
    echo "$DAEMON_PID" > "$HOME/.local/share/yanmo/daemon.pid"
    echo "🚀 言墨输入法守护进程已在后台启动 (PID: $DAEMON_PID)"
    echo "💡 提示: 全局按 Ctrl+Space 切换中英，按 Ctrl+Alt+Esc 或 Win+Y 可一键强制关闭/启动！"
    command -v notify-send >/dev/null 2>&1 && notify-send -t 2000 -i accessories-character-map "言墨输入法" "🚀 守护进程已启动 (PID: $DAEMON_PID)"
elif [ "$ACTION" = "stop" ]; then
    PID_FILE="$HOME/.local/share/yanmo/daemon.pid"
    PID=""
    if [ -f "$PID_FILE" ]; then
        PID="$(cat "$PID_FILE" 2>/dev/null)"
    fi
    "$PYTHON" -m daemon.yanmo_daemon stop
    # P1-3: Fallback kill -9 if process is still alive after 0.5s
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        sleep 0.5
        if kill -0 "$PID" 2>/dev/null; then
            echo "⚠️ 守护进程响应超时，执行 SIGKILL 强制杀除 (kill -9 $PID)..."
            kill -9 "$PID" 2>/dev/null || true
        fi
    fi
    pkill -9 -f "daemon.yanmo_daemon" 2>/dev/null || true
    rm -f "$HOME/.local/share/yanmo/daemon.pid" 2>/dev/null || true
    echo "🛑 言墨输入法守护进程已停止"
elif [ "$ACTION" = "restart" ]; then
    "$SCRIPT_PATH" stop
    sleep 0.5
    "$SCRIPT_PATH" start
elif [ "$ACTION" = "toggle" ]; then
    PID_FILE="$HOME/.local/share/yanmo/daemon.pid"
    RUNNING=0
    if [ -f "$PID_FILE" ]; then
        PID="$(cat "$PID_FILE" 2>/dev/null)"
        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            RUNNING=1
        fi
    fi
    if [ $RUNNING -eq 1 ]; then
        "$SCRIPT_PATH" stop
        command -v notify-send >/dev/null 2>&1 && notify-send -t 2000 -i input-keyboard "言墨输入法" "🛑 已强制关闭后台守护进程"
    else
        "$SCRIPT_PATH" start
    fi
else
    exec "$PYTHON" -m daemon.yanmo_daemon "$@"
fi
